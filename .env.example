# Configuration du backend Assistant Scolarité RAG
# Copiez ce fichier en `.env` à la racine du projet et renseignez votre clé API.
# Ne versionnez JAMAIS le fichier `.env`.

# Fournisseur LLM : gemini | ollama | fake
LLM_PROVIDER=gemini

# Configuration Gemini (obligatoire si LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Configuration Ollama (si LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embeddings multilingues (sentence-transformers | hash pour les tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_SEQ_LENGTH=384

# Paramètres RAG
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.35
EXPAND_MODIFICATIONS=true
EXPANSION_PER_DOC=2

# Origines CORS autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
